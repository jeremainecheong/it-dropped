# Frontend environment (Next.js)
# Copy to .env.local for local dev; set the same keys in the Vercel dashboard.

# --- Supabase --------------------------------------------------------------
# Project URL and publishable/anon key from Supabase -> Project Settings -> API.
# Safe to expose to the browser: the catalogue tables are readable by anyone
# and writable by nobody (migration 013), and user tables are scoped by RLS to
# the signed-in user. Never put the service key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# --- Site ------------------------------------------------------------------
# Canonical origin, used for canonical tags, the sitemap and OG image URLs.
# Defaults to https://itdropped.app, so leaving it unset on a different domain
# points your SEO at someone else's site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Scrape proxy ----------------------------------------------------------
# Server-only, and deliberately NOT NEXT_PUBLIC_: this is a bearer token.
#
# The daily scraper fetches the storefronts through /api/scrape/store rather
# than directly, because the stores rate limit GitHub Actions runner addresses
# on sight. That route refuses every request unless this is set, so it never
# falls open into a proxy anyone can use. Must match the GitHub Actions secret
# of the same name. Generate one with: openssl rand -hex 32
SCRAPE_PROXY_TOKEN=
