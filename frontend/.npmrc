# This project is a v0 scaffold: Next 14.2 declares a peer of react@^18.2.0
# while the app runs react@19. npm treats that as unresolvable and refuses to
# install, which fails the build on Vercel before it starts. The pairing works
# in practice — the app builds and renders — so accept the peer mismatch here
# rather than pin React back or jump to Next 15.
#
# This file is what makes `npm ci` reproducible locally and on Vercel; without
# it Vercel needs a custom install command, which is easy to forget.
legacy-peer-deps=true
